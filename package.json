{
  "name": "playwright-examples",
  "version": "1.0.0",
  "description": "testing playwright examples",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:chromium": "npx playwright test --project chromium",
    "test:first": "npx playwright test --grep @first",
    "test:local": "BASE_URL=http://localhost:4200 npx playwright test",
    "test:report": "npx playwright test && npx playwright show-report",
    "test:ui": "npx playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.13.4",
    "dotenv": "^16.4.7"
  }
}
